// Copy to appsettings.Local.json (git-ignored) and run with ASPNETCORE_ENVIRONMENT=Local.
// Local mode skips Key Vault and Entra entirely — see docs/getting-started.md
// § "Running locally without Azure (Local profile)".
//
// NEVER point DefaultConnection at Azure: startup refuses any connection string
// containing "database.windows.net" or "Authentication=Active Directory".
{
  "ConnectionStrings": {
    // Docker SQL Server from docs/getting-started.md:
    "DefaultConnection": "Server=localhost,1433;Database=SonaLocal;User Id=sa;Password=SonaDev_Local1!;Encrypt=True;TrustServerCertificate=True;Connection Timeout=30;",
    // Windows LocalDB alternative:
    // "DefaultConnection": "Server=(localdb)\\MSSQLLocalDB;Database=SonaLocal;Trusted_Connection=True;TrustServerCertificate=True;"
    // Opie_data (external read-only practice-management DB — docs/opie-odbc-integration.md).
    // Optional: leave it out and the dashboard shows "Opie connection not configured".
    // Use a READ-ONLY SQL login. Never commit real values.
    "OpieConnection": "Server=<opie-host>;Database=Opie_data;User Id=<readonly-user>;Password=<password>;Encrypt=True;TrustServerCertificate=True;Connection Timeout=30;"
  },
  // Which Sona organization the Opie schedule belongs to (Opie has no org concept). Only that
  // org's users and system_admin can see /api/opie/*; leave it out and the dashboard says
  // "Opie connection not configured" even with OpieConnection set.
  "Opie": {
    "OrganizationId": "<Organizations.Id of the clinic Opie_data belongs to>"
  },
  // The stub identity every request runs as in Local mode.
  "LocalDevAuth": {
    "Hca34Id": "DEV001",
    "Name": "Dev Admin",
    "Email": "dev.admin@example.com"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
