// Copy to appsettings.Local.json (git-ignored) and run with ASPNETCORE_ENVIRONMENT=Local.
// Local mode skips Key Vault and Entra entirely — see docs/getting-started.md
// § "Running locally without Azure (Local profile)".
//
// NEVER point DefaultConnection at Azure: startup refuses any connection string
// containing "database.windows.net" or "Authentication=Active Directory".
{
  "ConnectionStrings": {
    // Docker SQL Server from docs/getting-started.md:
    "DefaultConnection": "Server=localhost,1433;Database=SonaLocal;User Id=sa;Password=SonaDev_Local1!;Encrypt=True;TrustServerCertificate=True;Connection Timeout=30;"
    // Windows LocalDB alternative:
    // "DefaultConnection": "Server=(localdb)\\MSSQLLocalDB;Database=SonaLocal;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  // The stub identity every request runs as in Local mode.
  "LocalDevAuth": {
    "Hca34Id": "DEV001",
    "Name": "Dev Admin",
    "Email": "dev.admin@example.com"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
