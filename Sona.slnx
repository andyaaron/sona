<!-- Root solution for IDE convenience (Visual Studio 2022 17.13+, Rider, VS Code C# Dev Kit).
     JS apps (apps/sona.client, apps/mobile) and packages are pnpm workspaces — browse them via the
     Solution Explorer's Folder View; they are not VS projects. -->
<Solution>
  <Folder Name="/apps/">
    <Project Path="apps/sona.server/sona.server.csproj" />
    <Project Path="apps/sona.client/sona.client.esproj">
      <Build />
      <Deploy />
    </Project>
  </Folder>
  <Folder Name="/docs/">
    <File Path="docs/architecture.md" />
    <File Path="docs/compliance.md" />
    <File Path="docs/data-model.md" />
    <File Path="docs/getting-started.md" />
    <File Path="docs/patient-tasks.md" />
    <File Path="docs/tasks/00-fix-migration-baseline.md" />
    <File Path="docs/tasks/02-provider-assignment.md" />
    <File Path="docs/tasks/03-notifications-backend-history.md" />
    <File Path="docs/tasks/04-notify-confirmation.md" />
    <File Path="docs/tasks/05-bulk-csv-import.md" />
    <File Path="docs/tasks/06-pagination-and-sorting.md" />
    <File Path="docs/tasks/07-webex-sms-dispatch.md" />
    <File Path="docs/tasks/mvp-database.md" />
    <File Path="docs/tasks/_context.md" />
    <File Path="docs/tech-stack.md" />
  </Folder>
  <Folder Name="/config/">
    <File Path="AGENTS.md" />
    <File Path="README.md" />
    <File Path=".npmrc" />
    <File Path="package.json" />
    <File Path="pnpm-workspace.yaml" />
    <File Path="turbo.json" />
  </Folder>
</Solution>
